<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | Ashish Ranjan</title>
    <link rel="shortcut icon" href="/logo3 32.png" type="image/png">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: sans-serif;
        }

        @view-transition {
            navigation: auto;
        }

        ::view-transition-old(root) {
            animation: view-transition-old 0.5s ease;
        }
        ::view-transition-new(root) {
            animation: view-transition-new 0.5s ease;
        }

        @keyframes view-transition-old {
            to { transform: translateX(-100%); }
        }
        @keyframes view-transition-new {
            from { transform: translateX(100%); }
        }

        :root {
            --bg-main: #3d4f62;
            --bg-card: #111315;
            --text-primary: #ffffff;
            --text-muted: #9ca3af;
            --accent-blue: #006097;
            --accent-blue-hover: #004b76;
            --border-color: #374151;
            --input-focus: #00a3e0;
            --section-heading-gradient: linear-gradient(to right, aqua, rgb(0, 98, 255));
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .page-container {
            display: grid;
            grid-template-columns: 1fr;
            gap: 40px;
            max-width: 1200px;
            width: 100%;
            margin: auto;
            align-items: center;
        }

        /* --- Left Panel: Marketing Info --- */
        .info-panel {
            display: flex;
            flex-direction: column;
            gap: 24px;
            padding: 20px;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .logo span {
            background-image: var(--section-heading-gradient);
            font-size: 3rem;
            background-clip: text;
            color: transparent;
            font-weight: 700;
        }

        .headline {
            font-size: 2.5rem;
            font-weight: 600;
        }

        .subheadline {
            font-size: 1.2rem;
            color: var(--text-muted);
        }

        /* --- Right Panel: 3D Flip Card Architecture --- */
        .card {
            perspective: 1200px;
            width: 100%;
            max-width: 480px;
            justify-self: center;
        }

        .inner-card {
            position: relative;
            transform-style: preserve-3d;
            transform-origin: center;
            transition: transform 1s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .auth-card {
            background-color: var(--bg-card);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
            width: 100%;
            backface-visibility: hidden;
            position: absolute;
            top: 0;
            left: 0;
        }

        .success-card {
            position: relative; /* Let the success card dictate container size initially or post-flip */
            transform: rotateY(180deg);
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 20px;
        }

        .card-title {
            font-size: 2rem;
            font-weight: 500;
            text-align: center;
            margin-bottom: 24px;
        }

        form {
            width: 100%;
        }

        /* Form elements arranged cleanly into vertical rows */
        .form-rows-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            width: 100%;
            position: relative;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            color: var(--text-muted);
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            left: 14px;
            transition: all 0.15s ease-in-out;
            pointer-events: none;
            z-index: 10;
            background-color: var(--bg-card);
        }

        .form-input {
            width: 100%;
            background-color: transparent;
            border-radius: 6px;
            padding: 14px;
            color: var(--text-primary);
            font-size: 1rem;
            outline: none;
            display: block;
            border: 1px solid var(--border-color);
        }

        .form-input:focus {
            border-color: var(--input-focus);
        }
        
        .form-input:focus + .form-label,
        .form-input:not(:placeholder-shown) + .form-label {
            top: 0;
            left: 10px;
            transform: translateY(-50%);
            font-size: 0.7rem;
            padding: 0 0.25rem;
        }

        /* Readonly styles for email field */
        .form-input:read-only {
            color: var(--text-muted);
            border-style: dashed;
            cursor: not-allowed;
        }

        .btn-primary {
            width: 100%;
            background-color: var(--accent-blue);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 14px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
        }

        .btn-primary:hover {
            background-color: var(--accent-blue-hover);
        }

        .error-message {
            font-size: 0.9rem;
            color: #ff4a4a;
            margin-bottom: 12px;
            min-height: 1.2rem;
            transition: opacity 0.2s ease;
        }

        .disabled {
            pointer-events: none;
            background: #000000;
            user-select: none;
        }

        .success-text {
            color: #00cc66;
            font-size: 1.1rem;
            line-height: 1.5;
        }

        /* Loading Dots animation */
        .dot-container {
            display: flex;
            gap: 6px;
        }
        .dot {
            height: 0.6rem;
            width: 0.6rem;
            border-radius: 50%;
        }
        .dot1 { background-color: #00cc66; animation: dotanimation 1.1s ease-in-out infinite alternate; }
        .dot2 { background-color: #ff4a4a; animation: dotanimation 1.2s ease-in-out infinite alternate; }
        .dot3 { background-color: rgb(248, 248, 54); animation: dotanimation 1s ease-in-out infinite alternate; }
        .dot4 { background-color: rgb(255, 170, 0); animation: dotanimation 1s ease-in-out infinite alternate; }

        @keyframes dotanimation {
            from { transform: translateY(-5px); }
            to { transform: translateY(5px); }
        }

        @media (max-width: 1210px) {
    /* Vertical Transition Tweaks */
            @keyframes view-transition-old { to { transform: translateY(-100%); } }
            @keyframes view-transition-new { from { transform: translateY(100%); } }
        }
        /* --- Responsive Breakpoints --- */
        @media (min-width: 950px) {
            .page-container {
                grid-template-columns: 1.1fr 0.9fr;
                gap: 60px;
            }
        }



        @media (max-width: 950px) {
            .info-panel {
                display: none;
            }
        }
    </style>
</head>
<body>

    <div class="page-container">
        
        <section class="info-panel">
            <div class="logo">
                <img src="/LOGO3 3rem.png" alt="LOGO" height="64px" width="64px"> 
                <span>Ashish Ranjan</span>
            </div>
            <h1 class="headline">Secure Your Account.</h1>
            <p class="subheadline">Update your credentials to restore secure entry to your portfolio and applications.</p>
        </section>

        <div class="card" id="cardContainer">
            <div class="inner-card" id="innerCard">
                
                <!-- Front Side: Reset Password Form -->
                <main class="auth-card reset-card">
                    <h2 class="card-title">Reset Password</h2>
                    
                    <form id="resetForm">
                        <div class="form-rows-container">
                            <!-- Email address (Pre-filled via server) -->
                            <div class="form-group">
                                <input class="form-input" type="email" id="email" name="email" value="<%= email %>" placeholder=" " readonly required>
                                <label class="form-label" for="email">Email address</label>
                            </div>
                            <!-- New Password -->
                            <div class="form-group">
                                <input class="form-input" type="password" id="password" name="password" placeholder=" " required>
                                <label class="form-label" for="password">New Password</label>
                            </div>
                            <!-- Confirm New Password -->
                            <div class="form-group">
                                <input class="form-input" type="password" id="confirmPassword" name="confirmPassword" placeholder=" " required>
                                <label class="form-label" for="confirmPassword">Confirm Password</label>
                            </div>
                        </div>
                        
                        <div class="error-message" id="errorDisplay"></div>
                        <button type="submit" class="btn-primary" id="resetBtn">Reset</button>
                    </form>
                </main>

                <!-- Back Side: Success Feedback -->
                <main class="auth-card success-card">
                    <h2 class="card-title" style="color: #00cc66;">Success!</h2>
                    <p class="success-text">Your password has been successfully changed. You can now login with your new password.</p>
                    <button class="btn-primary" onclick="window.location.href='/registration'">Go to Login</button>
                </main>

            </div>
        </div>

    </div>

    <script>
        const cardContainer = document.getElementById("cardContainer");
        const innerCard = document.getElementById("innerCard");
        const resetForm = document.getElementById("resetForm");
        const resetBtn = document.getElementById("resetBtn");
        const errorDisplay = document.getElementById("errorDisplay");

        const passwordInput = document.getElementById("password");
        const confirmPasswordInput = document.getElementById("confirmPassword");

        // Dynanically match parent element dimensions to ensure clean transitions
        function adjustCardHeight() {
            const frontCard = document.querySelector(".reset-card");
            cardContainer.style.height = frontCard.offsetHeight + "px";
        }
        window.addEventListener("load", adjustCardHeight);
        window.addEventListener("resize", adjustCardHeight);

        resetForm.addEventListener("submit", async (event) => {
            event.preventDefault();
            errorDisplay.textContent = "";

            if ("vibrate" in navigator) {
                navigator.vibrate(50);
            }

            // Client-side structural match authentication check
            if (passwordInput.value !== confirmPasswordInput.value) {
                errorDisplay.textContent = "Passwords do not match.";
                return;
            }

            // Capture target path parameter token directly from page URL array context
            const urlPathSegments = window.location.pathname.split('/');
            const token = urlPathSegments[urlPathSegments.length - 1];

            // Set up processing UI state layout parameters
            resetBtn.classList.add("disabled");
            resetBtn.textContent = "";
            const dotContainer = document.createElement("div");
            dotContainer.classList.add("dot-container");
            for (let i = 1; i <= 4; i++) {
                let dot = document.createElement("div");
                dot.classList.add("dot", `dot${i}`);
                dotContainer.appendChild(dot);
            }
            resetBtn.appendChild(dotContainer);

            try {
                const response = await fetch(`/auth/reset-password/${token}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        password: passwordInput.value
                    })
                });

                if (response.status === 200) {
                    // Switch wrapper height dynamically to render back component gracefully without overflows
                    const backCard = document.querySelector(".success-card");
                    cardContainer.style.height = backCard.offsetHeight + "px";
                    
                    // Trigger 3D rotation transition matrices
                    innerCard.style.transform = "rotateY(180deg)";
                } else {
                    const resultMessage = await response.json();
                    throw new Error(resultMessage.message || "Failed to reset password.");
                }
            } catch (err) {
                errorDisplay.textContent = err.message;
                resetBtn.replaceChildren();
                resetBtn.classList.remove("disabled");
                resetBtn.textContent = "Reset";
            }
        });
    </script>
</body>
</html>